{
  "welcomeFile": "/launchpad/flp.html",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/travel/(.*)$",
      "target": "/travel/$1",
      "destination": "primepath-srv-api",
      "csrfProtection": false
    },
    {
      "source": "^/launchpad/(.*)$",
      "target": "$1",
      "localDir": "launchpad",
      "authenticationType": "none"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "none"
    }
  ]
}
