{
  "requires": {
    "db": {
      "kind": "sqlite",
      "[production]": {
        "kind": "hana",
        "deploy-format": "hdbtable"
      }
    },
    "auth": {
      "kind": "mocked",
      "users": {
        "Admin": {
          "password": "Admin",
          "roles": ["TravelCoordinator", "TeamLead", "HRAdmin"]
        },
        "coordinator": { "roles": ["TravelCoordinator"] },
        "teamlead": { "roles": ["TeamLead"] },
        "hradmin": { "roles": ["HRAdmin"] }
      },
      "[production]": {
        "kind": "dummy"
      }
    },
    "TripPinService": {
      "kind": "odata-v4",
      "model": "srv/external/TripPinService",
      "credentials": {
        "url": "https://services.odata.org/TripPinRESTierService"
      },
      "[production]": {
        "credentials": {
          "destination": "TripPin",
          "path": "/"
        }
      }
    }
  }
}
