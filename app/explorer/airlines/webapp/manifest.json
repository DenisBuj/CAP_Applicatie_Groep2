{
  "_version": "1.59.0",
  "sap.app": {
    "id": "primepath.explorer.airlines",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "mainService": {
        "uri": "/travel/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "primepath.explorer.airlines.i18n.i18n" }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        { "pattern": ":?query:",                             "name": "KPISummaryPage",              "target": "KPISummaryPage" },
        { "pattern": "Airlines:?query:",                     "name": "AirlinesList",                "target": "AirlinesList" },
        { "pattern": "Airlines({key}):?query:",              "name": "AirlinesObjectPage",          "target": "AirlinesObjectPage" },
        { "pattern": "Airports:?query:",                     "name": "AirportsList",                "target": "AirportsList" },
        { "pattern": "AirlineExtensions:?query:",            "name": "AirlineExtensionsList",       "target": "AirlineExtensionsList" },
        { "pattern": "AirlineExtensions({key}):?query:",     "name": "AirlineExtensionsObjectPage", "target": "AirlineExtensionsObjectPage" }
      ],
      "targets": {
        "KPISummaryPage": {
          "type": "Component",
          "id": "KPISummaryPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/KPISummary"
            }
          }
        },
        "AirlinesList": {
          "type": "Component",
          "id": "AirlinesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Airlines",
              "variantManagement": "Page",
              "initialLoad": true,
              "navigation": {
                "Airlines": {
                  "detail": { "route": "AirlinesObjectPage" }
                }
              }
            }
          }
        },
        "AirlinesObjectPage": {
          "type": "Component",
          "id": "AirlinesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Airlines"
            }
          }
        },
        "AirportsList": {
          "type": "Component",
          "id": "AirportsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Airports",
              "variantManagement": "Page",
              "initialLoad": true
            }
          }
        },
        "AirlineExtensionsList": {
          "type": "Component",
          "id": "AirlineExtensionsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/AirlineExtensions",
              "variantManagement": "Page",
              "initialLoad": true,
              "navigation": {
                "AirlineExtensions": {
                  "detail": { "route": "AirlineExtensionsObjectPage" }
                }
              }
            }
          }
        },
        "AirlineExtensionsObjectPage": {
          "type": "Component",
          "id": "AirlineExtensionsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/AirlineExtensions"
            }
          }
        }
      }
    },
    "contentDensities": { "compact": true, "cozy": true }
  }
}
