{
  "_version": "1.59.0",
  "sap.app": {
    "id": "primepath.explorer.airlines",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "mainService": {
        "uri": "/travel/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Airlines-display": {
          "semanticObject": "Airlines",
          "action": "display",
          "title": "{{appTitle}}",
          "subTitle": "{{appSubTitle}}",
          "icon": "sap-icon://airplane",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "primepath.explorer.airlines.i18n.i18n" }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        { "pattern": ":?query:",                             "name": "AirlinesList",                "target": "AirlinesList" },
        { "pattern": "Airlines({key}):?query:",              "name": "AirlinesObjectPage",          "target": "AirlinesObjectPage" },
        { "pattern": "Airports:?query:",                     "name": "AirportsList",                "target": "AirportsList" },
        { "pattern": "KPISummary:?query:",                   "name": "KPISummaryPage",              "target": "KPISummaryPage" }
      ],
      "targets": {
        "KPISummaryPage": {
          "type": "Component",
          "id": "KPISummaryPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/KPISummary"
            }
          }
        },
        "AirlinesList": {
          "type": "Component",
          "id": "AirlinesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Airlines",
              "variantManagement": "Page",
              "initialLoad": true,
              "navigation": {
                "Airlines": {
                  "detail": { "route": "AirlinesObjectPage" }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "openKPIs": {
                      "press": "primepath.explorer.airlines.ext.ListReportExtend.openKPIOverview",
                      "text": "{{action_openKPIs}}",
                      "position": { "placement": "After" }
                    }
                  }
                }
              }
            }
          }
        },
        "AirlinesObjectPage": {
          "type": "Component",
          "id": "AirlinesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Airlines"
            }
          }
        },
        "AirportsList": {
          "type": "Component",
          "id": "AirportsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Airports",
              "variantManagement": "Page",
              "initialLoad": true
            }
          }
        }
      }
    },
    "contentDensities": { "compact": true, "cozy": true }
  }
}
