{
  "_version": "1.59.0",
  "sap.app": {
    "id": "primepath.explorer.trips",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "mainService": {
        "uri": "/travel/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "primepath.explorer.trips.i18n.i18n" }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        { "pattern": ":?query:", "name": "TripsList", "target": "TripsList" },
        { "pattern": "Trips({key}):?query:", "name": "TripsObjectPage", "target": "TripsObjectPage" }
      ],
      "targets": {
        "TripsList": {
          "type": "Component",
          "id": "TripsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Trips",
              "variantManagement": "Page",
              "initialLoad": true,
              "navigation": {
                "Trips": {
                  "detail": { "route": "TripsObjectPage" }
                }
              }
            }
          }
        },
        "TripsObjectPage": {
          "type": "Component",
          "id": "TripsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Trips"
            }
          }
        }
      }
    },
    "contentDensities": { "compact": true, "cozy": true }
  }
}
