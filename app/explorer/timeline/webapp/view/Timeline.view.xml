<mvc:View
  controllerName="primepath.explorer.timeline.controller.Timeline"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:unified="sap.ui.unified"
  displayBlock="true">
  <Page id="page" title="{i18n>appTitle}" class="sapUiResponsiveContentPadding">
    <content>
      <PlanningCalendar
        id="pc"
        startDate="{/startDate}"
        rows="{/rows}"
        viewKey="Month"
        showWeekNumbers="true">
        <rows>
          <PlanningCalendarRow
            title="{title}"
            text="{text}"
            appointments="{path: 'appointments', templateShareable: false}">
            <appointments>
              <unified:CalendarAppointment
                startDate="{start}"
                endDate="{end}"
                title="{name}"
                text="{status}"
                type="{type}" />
            </appointments>
          </PlanningCalendarRow>
        </rows>
      </PlanningCalendar>
    </content>
  </Page>
</mvc:View>
