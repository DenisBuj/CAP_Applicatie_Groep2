{
  "name": "primepath-travel-dashboard",
  "version": "1.0.0",
  "description": "PrimePath Travel Dashboard — SAP CAP full-stack travel management application (Erasmushogeschool Brussel / Flexso)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "^20 || ^22 || ^24"
  },
  "workspaces": [
    "app/explorer/trips",
    "app/explorer/employees",
    "app/explorer/airlines"
  ],
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cds build --production",
    "open-trips":      "open http://localhost:4004/explorer/trips/webapp/index.html",
    "open-employees":  "open http://localhost:4004/explorer/employees/webapp/index.html",
    "open-airlines":   "open http://localhost:4004/explorer/airlines/webapp/index.html",
    "open-all":        "open http://localhost:4004/explorer/trips/webapp/index.html && open http://localhost:4004/explorer/employees/webapp/index.html && open http://localhost:4004/explorer/airlines/webapp/index.html"
  },
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^9.9.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.0",
    "@sap/cds-dk": "^9.9.2"
  }
}
